<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The process's narrow-character code page is UTF-8 (Windows 10 1903 and later): command-line arguments, fopen
     and std::filesystem's char strings then carry any folder or file name, not only those of the system's ANSI
     code page. Merged into both executables by CMake. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
